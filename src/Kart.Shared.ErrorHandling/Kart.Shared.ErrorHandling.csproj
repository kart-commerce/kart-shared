<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kart.Shared.ErrorHandling</PackageId>
    <Description>Global exception-handling middleware + ProblemDetails factory (traceId/errorCode extensions) shared across Kart's microservices, per kart-conventions.md's Error Handling &amp; Response Consistency section.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.3.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- IExceptionHandler, ProblemDetails, HttpContext — needed for a class library that plugs
         into ASP.NET Core's own exception-handling pipeline. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
